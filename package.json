{
  "name": "valiryan-freehold-pc",
  "version": "1.0.0",
  "description": "VALIRYAN FREEHOLD – desktop browser app",
  "author": "you",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.valiryan.freehold.desktop",
    "productName": "VALIRYAN FREEHOLD",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "www/**/*"],
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Valiryan-Freehold-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Valiryan-Freehold-Portable-${version}.${ext}"
    }
  }
}
